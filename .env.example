# ─────────────────────────────────────────────────────────────
#  Copier en `.env` à la racine :  cp .env.example .env
#  docker compose lit CE fichier. Les apps ont leur propre .env
#  (voir apps/api/.env.example, apps/web/.env.example).
# ─────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380

# Mailpit (SMTP de dev + UI)
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# URL de connexion utilisée par apps/api (Prisma)
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:5433/lms?schema=public
